# ─────────────────────────────────────────────────────────────
# MikroTik Web Manager - variables de entorno
# Copiar a `.env.local` y completar. NUNCA commitear valores reales.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Identidad de la aplicacion
APP_NAME="MikroTik Web Manager"
APP_URL=http://localhost:3000

# SQLite (ruta relativa al root del proyecto o absoluta)
DATABASE_FILE=./data/mikrotik-manager.sqlite

# Sesiones / JWT
# Generar:  openssl rand -base64 48
#   Windows sin openssl:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# Clave AES-256-GCM para cifrar las contrasenas de los routers en reposo.
# Acepta 32 bytes en base64, 64 caracteres hex, o cualquier texto (se deriva con
# SHA-256 como ultimo recurso).
# Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# RouterOS / MikroTik
MIKROTIK_API_PORT=8728
MIKROTIK_API_SSL_PORT=8729
MIKROTIK_DEFAULT_TIMEOUT_MS=8000
MIKROTIK_POOL_MAX_CONNECTIONS=8

# Observabilidad
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Solo desarrollo: overrides de `npm run db:seed` (todos opcionales)
# ─────────────────────────────────────────────────────────────
# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=admin12345
# SEED_OWNER_EMAIL=owner@localhost
# SEED_ROUTER_NAME=Router Demo
# SEED_ROUTER_HOST=192.168.88.1
# SEED_ROUTER_USERNAME=admin
# SEED_ROUTER_PASSWORD=admin
# SEED_HOTSPOT_PROFILE=default
# SEED_CURRENCY=PEN
# SEED_TIMEZONE=America/Lima
